#!/usr/bin/env bash
# Capture a screen region with OCR, then open Translate.
set -euo pipefail

PLUGIN_ID="io.github.antunesales-dev.translate"
RUNTIME="${XDG_RUNTIME_DIR:-${HOME:-/tmp}/.cache}/omarchy-translate"
mkdir -p -m 700 "$RUNTIME"
CLIP="$RUNTIME/clip.txt"

cleanup_freeze() {
  [[ -n ${PID:-} ]] && kill "$PID" 2>/dev/null || true
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null) || exit 0
[[ -z $SELECTION ]] && exit 0

ALLOW="eng por spa fra deu ita nld pol rus ukr tur ara heb hin jpn kor chi_sim chi_tra ind vie tha ces ell swe dan fin nor ron hun bul hrv slk slv lit lav est cat glg eus gle cym isl fas urd ben tam tel msa tgl swa afr"
installed="$(tesseract --list-langs 2>/dev/null || true)"
want="${1:-}"
allowed=0
if [[ $want =~ ^[a-z0-9_]+$ ]]; then
  for code in $ALLOW; do
    if [[ $code == "$want" ]]; then
      allowed=1
      break
    fi
  done
fi
[[ $allowed -eq 1 ]] || want=""
OCR_LANGS="eng"
if [[ -n $want && $want != eng ]] && printf '%s\n' "$installed" | grep -Fqx -- "$want"; then
  OCR_LANGS="eng+$want"
else
  for code in $ALLOW; do
    [[ $code == eng ]] && continue
    printf '%s\n' "$installed" | grep -Fqx -- "$code" || continue
    OCR_LANGS="$OCR_LANGS+$code"
  done
fi
TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "$OCR_LANGS" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
TEXT=$(printf '%s' "$TEXT" | sed 's/[[:space:]]*$//')
[[ -z $TEXT ]] && {
  omarchy-notification-send -g 󰗊 "No text found in that region"
  exit 1
}

printf '%s' "$TEXT" | wl-copy
printf '%s' "$TEXT" >"$CLIP"
chmod 600 "$CLIP"
omarchy-notification-send -g 󰗊 "OCR text copied — translating"
omarchy-shell shell summon "$PLUGIN_ID" '{}'
