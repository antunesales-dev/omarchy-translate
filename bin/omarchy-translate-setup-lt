#!/usr/bin/env bash
# Start a local LibreTranslate container (open-source engine, no Google).
# Image is pinned to LibreTranslate v1.9.6 by digest so a later :latest
# retag cannot change what this script runs.
set -euo pipefail

NAME="omarchy-libretranslate"
# Multi-arch index digest for libretranslate/libretranslate:v1.9.6
# (hub.docker.com, 2026-05-26).
IMAGE="libretranslate/libretranslate:v1.9.6@sha256:1de2d7056bb8ad607a412f4563d9abe324ff632b43b5be9428bcc8e213aebb32"
PIN="sha256:1de2d7056bb8ad607a412f4563d9abe324ff632b43b5be9428bcc8e213aebb32"

if ! command -v docker >/dev/null; then
  echo "Docker is not installed. Install it with: omarchy install docker" >&2
  exit 1
fi

container_image() {
  docker inspect -f '{{.Config.Image}} {{range .RepoDigests}}{{.}} {{end}}' "$NAME" 2>/dev/null || true
}

pinned() {
  local info
  info="$(container_image)"
  [[ "$info" == *"$PIN"* ]]
}

if docker ps --format '{{.Names}}' | grep -qx "$NAME"; then
  if pinned; then
    echo "LibreTranslate v1.9.6 is already running at http://127.0.0.1:5000"
    exit 0
  fi
  echo "Container $NAME is running an unpinned image. Stop and remove it, then rerun:" >&2
  echo "  docker rm -f $NAME" >&2
  exit 1
fi

if docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; then
  if pinned; then
    docker start "$NAME" >/dev/null
    echo "Started pinned container $NAME on http://127.0.0.1:5000"
    exit 0
  fi
  echo "Removing unpinned container $NAME so it can be recreated at $PIN"
  docker rm "$NAME" >/dev/null
fi

echo "Pulling pinned LibreTranslate v1.9.6 ($PIN)…"
docker pull "$IMAGE"
docker run -d --name "$NAME" -p 127.0.0.1:5000:5000 --restart unless-stopped --pull=never "$IMAGE" >/dev/null
echo "LibreTranslate v1.9.6 is starting at http://127.0.0.1:5000"
echo "In the Translate panel, set Engine to LibreTranslate (URL defaults to that address)."
